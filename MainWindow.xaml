<Window x:Class="QuickDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickDock"
        xmlns:models="clr-namespace:QuickDock.Models"
        mc:Ignorable="d"
        Title="QuickDock"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="Assets/app.ico"
        Background="Transparent"
        Width="296"
        SizeToContent="Height"
        MinHeight="160"
        MaxHeight="450"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SizeChanged="MainWindow_SizeChanged">

    <Window.Resources>
        <!-- Dynamic Theme Brushes (Updated at runtime) -->
        <SolidColorBrush x:Key="WindowTintBrush" Color="#EE1E1E1E"/>
        <SolidColorBrush x:Key="InnerBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#F01E1E1E"/>
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#2AFFFFFF"/>
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#30888888"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#60888888"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#30FF4444"/>

        <!-- Header Action Button Style -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    <Setter Property="Opacity" Value="1.0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Tooltip Style -->
        <Style x:Key="ModernToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Auto-hiding ScrollBar Style -->
        <Style x:Key="AiryScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ScrollBarThumbBrush}"
                                CornerRadius="2"
                                Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiryScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AiryScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Airy ScrollViewer Template -->
        <Style x:Key="AiryScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource AiryScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu Style -->
        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource WindowTintBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InnerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with 1px delicate inner border & Transient Acrylic background -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{DynamicResource InnerBorderBrush}"
            Background="{DynamicResource WindowTintBrush}"
            Padding="12,10,12,12"
            RenderTransformOrigin="0.5,1.0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootTranslate" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- HEADER SECTION                                 -->
            <!-- ============================================== -->
            <Grid Grid.Row="0" Margin="10,2,2,8">
                <!-- 1. FAVORITES HEADER -->
                <Grid x:Name="FavoritesHeader" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clean Modern Fluent Folder Badge -->
                        <Path Data="M2,3 C2,2.45 2.45,2 3,2 L6.5,2 C6.9,2 7.27,2.23 7.45,2.58 L8,3.7 C8.18,4.06 8.55,4.29 8.95,4.29 L14,4.29 C14.55,4.29 15,4.74 15,5.29 L15,11 C15,11.55 14.55,12 14,12 L3,12 C2.45,12 2,11.55 2,11 Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Opacity="0.8"
                              Width="13"
                              Height="11"
                              Stretch="Uniform"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="FAVORITES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Button (Gear) -->
                        <Border x:Name="SettingsButton"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Cursor="Hand"
                                Margin="0,0,2,0"
                                ToolTipService.ToolTip="Configure Folders"
                                ToolTipService.Placement="Left"
                                MouseLeftButtonUp="SettingsButton_MouseLeftButtonUp">
                            <!-- Fluent Gear Icon -->
                            <Path Data="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="11"
                                  Height="11"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Refresh Button -->
                        <Border x:Name="RefreshButton"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Cursor="Hand"
                                Margin="0,0,2,0"
                                ToolTipService.ToolTip="Refresh Folders"
                                ToolTipService.Placement="Left"
                                MouseLeftButtonUp="RefreshButton_MouseLeftButtonUp">
                            <!-- Modern Refresh Icon (Lucide/Fluent CW circular arrow) -->
                            <Path x:Name="RefreshIconPath"
                                  Data="M 21,12 A 9,9 0 1,1 12,3 C 14.5,3 16.9,4 18.7,5.7 L 21,8 M 21,3 L 21,8 L 16,8"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="10.5"
                                  Height="10.5"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="RefreshIconRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>

                        <!-- Close/Exit Button -->
                        <Border x:Name="ExitButton"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Cursor="Hand"
                                ToolTipService.ToolTip="Close"
                                ToolTipService.Placement="Left"
                                MouseLeftButtonUp="ExitButton_MouseLeftButtonUp">
                            <!-- Clean Close Cross (✕) -->
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="9"
                                  Height="9"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. SETTINGS HEADER -->
                <Grid x:Name="SettingsHeader" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Back Button (←) -->
                        <Border x:Name="BackToFavoritesButton"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Cursor="Hand"
                                Margin="0,0,6,0"
                                ToolTipService.ToolTip="Back to Favorites"
                                MouseLeftButtonUp="BackToFavorites_MouseLeftButtonUp">
                            <Path Data="M19,12 L5,12 M12,19 L5,12 L12,5"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="CONFIGURE DOCK"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Add Folder Header Action Button (+) -->
                        <Border x:Name="HeaderAddFolderButton"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Cursor="Hand"
                                Margin="0,0,2,0"
                                ToolTipService.ToolTip="Add Folder"
                                ToolTipService.Placement="Left"
                                MouseLeftButtonUp="AddFolderButton_MouseLeftButtonUp">
                            <Path Data="M12,5 L12,19 M5,12 L19,12"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Close Button (✕) -->
                        <Border Style="{StaticResource HeaderActionButtonStyle}"
                                Width="22"
                                Height="22"
                                CornerRadius="5"
                                Cursor="Hand"
                                ToolTipService.ToolTip="Close"
                                ToolTipService.Placement="Left"
                                MouseLeftButtonUp="ExitButton_MouseLeftButtonUp">
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="9"
                                  Height="9"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- BODY / CONTENT SECTION                         -->
            <!-- ============================================== -->
            <Grid Grid.Row="1">
                <!-- ========================================== -->
                <!-- 1. FAVORITES VIEW                          -->
                <!-- ========================================== -->
                <Grid x:Name="FavoritesPanel" Visibility="Visible">
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyStateText"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,20,0,20"
                                Visibility="Collapsed">
                        <TextBlock Text="No folders in dock"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <Border Margin="0,8,0,0"
                                Padding="8,4"
                                CornerRadius="5"
                                Background="{DynamicResource ButtonHoverBrush}"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                MouseLeftButtonUp="SettingsButton_MouseLeftButtonUp">
                            <TextBlock Text="+ Configure Folders"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Folders Scrollable List -->
                    <ScrollViewer x:Name="FoldersScrollViewer"
                                  Style="{StaticResource AiryScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FoldersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:QuickAccessItem}">
                                    <Border x:Name="RowBorder"
                                            CornerRadius="8"
                                            Margin="0,2"
                                            Height="42"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="FolderRow_MouseLeftButtonUp">
                                        <Border.ToolTip>
                                            <ToolTip Content="{Binding Path}" Style="{StaticResource ModernToolTipStyle}"/>
                                        </Border.ToolTip>
                                        <!-- Right-Click Context Menu -->
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}"
                                                         Opened="ContextMenu_Opened"
                                                         Closed="ContextMenu_Closed">
                                                <MenuItem Header="Open in File Explorer"
                                                          Style="{StaticResource ModernMenuItemStyle}"
                                                          Click="ContextMenu_OpenFolder_Click"/>
                                                <MenuItem Header="Open in Windows Terminal"
                                                          Style="{StaticResource ModernMenuItemStyle}"
                                                          Click="ContextMenu_OpenTerminal_Click"/>
                                                <Separator Background="{DynamicResource InnerBorderBrush}" Margin="4,2"/>
                                                <MenuItem Header="Remove from Dock"
                                                          Style="{StaticResource ModernMenuItemStyle}"
                                                          Click="ContextMenu_RemoveFolder_Click"/>
                                                <MenuItem Header="Configure Folders..."
                                                          Style="{StaticResource ModernMenuItemStyle}"
                                                          Click="ContextMenu_Settings_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <!-- Animated soft pill highlight on hover -->
                                            <Border x:Name="HoverPill"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource RowHoverBrush}"
                                                    Opacity="0"/>

                                            <Grid Margin="10,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Clean 20x20 Native Windows Folder Icon -->
                                                <Image Grid.Column="0"
                                                       Source="{Binding Icon}"
                                                       Width="20"
                                                       Height="20"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Margin="0,0,12,0"
                                                       VerticalAlignment="Center"/>

                                                <!-- Folder Name in Segoe UI Variable Text (Ellipsis truncation) -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Subtle Hover Action: Windows Terminal button -->
                                                <Border x:Name="TerminalButton"
                                                        Grid.Column="2"
                                                        Width="26"
                                                        Height="26"
                                                        CornerRadius="6"
                                                        Background="Transparent"
                                                        Opacity="0"
                                                        Cursor="Hand"
                                                        ToolTipService.ToolTip="Open in Windows Terminal"
                                                        ToolTipService.Placement="Left"
                                                        MouseLeftButtonUp="TerminalButton_MouseLeftButtonUp">
                                                    <!-- Clean Modern Terminal Prompt Icon (> _) -->
                                                    <Path Data="M3,4 L8,8 L3,12 M9,12 L14,12"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Width="12"
                                                          Height="12"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <!-- Row Hover: Smooth 120ms color transition & show terminal button -->
                                        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverPill"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1.0"
                                                                         Duration="0:0:0.120"/>
                                                        <DoubleAnimation Storyboard.TargetName="TerminalButton"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.7"
                                                                         Duration="0:0:0.120"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverPill"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.0"
                                                                         Duration="0:0:0.120"/>
                                                        <DoubleAnimation Storyboard.TargetName="TerminalButton"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.0"
                                                                         Duration="0:0:0.120"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <!-- Terminal Button Hover State -->
                                        <Trigger SourceName="TerminalButton" Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TerminalButton"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1.0"
                                                                         Duration="0:0:0.080"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="TerminalButton"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.7"
                                                                         Duration="0:0:0.080"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                            <Setter TargetName="TerminalButton" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. SETTINGS VIEW (CONFIGURE DOCK)          -->
                <!-- ========================================== -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action: Add Folder Banner Button -->
                    <Border Grid.Row="0"
                            x:Name="AddFolderBannerButton"
                            CornerRadius="7"
                            Height="32"
                            Margin="0,0,0,6"
                            Background="{DynamicResource RowHoverBrush}"
                            BorderBrush="{DynamicResource InnerBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="AddFolderButton_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,5 L12,19 M5,12 L19,12"
                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="10"
                                      Height="10"
                                      VerticalAlignment="Center"
                                      Margin="0,0,7,0"/>
                                <TextBlock Text="Add Folder to Dock..."
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty State in Settings -->
                    <TextBlock Grid.Row="1"
                               x:Name="SettingsEmptyStateText"
                               Text="No folders added to dock yet"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,16,0,16"
                               Visibility="Collapsed"/>

                    <!-- Scrollable List of Configured Folders -->
                    <ScrollViewer Grid.Row="1"
                                  x:Name="SettingsScrollViewer"
                                  Style="{StaticResource AiryScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="330">
                        <ItemsControl x:Name="SettingsFoldersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:QuickAccessItem}">
                                    <Border x:Name="SettingsRowBorder"
                                            CornerRadius="8"
                                            Margin="0,2"
                                            Height="44"
                                            Background="Transparent">
                                        <Grid>
                                            <!-- Soft hover pill -->
                                            <Border x:Name="SettingsHoverPill"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource RowHoverBrush}"
                                                    Opacity="0"/>

                                            <Grid Margin="6,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Reorder Up/Down arrows -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Folder Icon -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Folder Name & Path -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Remove Button -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Up / Down Reorder Arrows -->
                                                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <Border Width="16" Height="13" CornerRadius="3" Background="Transparent" Cursor="Hand"
                                                            ToolTipService.ToolTip="Move Up"
                                                            MouseLeftButtonUp="MoveUp_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Data="M16,13 L10,7 L4,13"
                                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Width="7" Height="5.5" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Width="16" Height="13" CornerRadius="3" Background="Transparent" Cursor="Hand"
                                                            ToolTipService.ToolTip="Move Down"
                                                            MouseLeftButtonUp="MoveDown_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Data="M4,7 L10,13 L16,7"
                                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Width="7" Height="5.5" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Folder Icon -->
                                                <Image Grid.Column="1"
                                                       Source="{Binding Icon}"
                                                       Width="18"
                                                       Height="18"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>

                                                <!-- Name and Path -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Opacity="0.65"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Remove Button (✕) -->
                                                <Border Grid.Column="3"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="5"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        ToolTipService.ToolTip="Remove from Dock"
                                                        MouseLeftButtonUp="RemoveFolder_MouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Data="M15,5 L5,15 M5,5 L15,15"
                                                          Stroke="#EEFF6666"
                                                          StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="8.5"
                                                          Height="8.5"
                                                          Stretch="Uniform"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="SettingsRowBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SettingsHoverPill" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Action: Reset to File Explorer Defaults -->
                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Padding="6,4"
                            CornerRadius="5"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            ToolTipService.ToolTip="Restore original Windows File Explorer Quick Access folders"
                            MouseLeftButtonUp="ResetDefaults_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="8"
                                  Height="8"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"
                                  Opacity="0.7"/>
                            <TextBlock Text="Reset to Quick Access defaults"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Opacity="0.75"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
